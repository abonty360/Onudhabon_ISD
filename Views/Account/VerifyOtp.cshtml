@model Onudhabon_ISD.Models.VerifyOtpViewModel

@{
    Layout = null;
    ViewData["Title"] = "Verify Email OTP - Onudhabon";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <style>
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 24px 0;
        }

        .otp-box {
            width: 50px;
            height: 58px;
            text-align: center;
            font-size: 26px;
            font-weight: 700;
            color: #1e3a8a;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            transition: all 0.2s ease;
            font-family: 'Courier New', Courier, monospace;
        }

        .otp-box:focus {
            border-color: #2563eb;
            background: #ffffff;
            outline: none;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
            transform: translateY(-2px);
        }

        .otp-box.filled {
            border-color: #3b82f6;
            background: #eff6ff;
        }

        .icon-badge {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            color: #1d4ed8;
            margin-bottom: 16px;
        }

        .timer-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: #f1f5f9;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #475569;
        }

        .timer-badge.expiring {
            background: #fee2e2;
            color: #b91c1c;
        }
    </style>
</head>
<body>
    <div class="login-page-container">
        <div class="login-card" style="max-width: 480px;">
            <!-- Logo Section -->
            <div class="logo-section">
                <a asp-controller="Home" asp-action="Index" class="logo-link">
                    <img src="~/images/login_logo.png" asp-append-version="true" alt="Onudhabon Logo" class="logo-icon" />
                </a>
                <h1 class="app-title">Onudhabon</h1>
                <div class="subtitle">Exploring Education</div>
            </div>

            <div class="px-4 pt-1 pb-4 text-center">
                <div class="icon-badge shadow-sm">
                    <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>

                <h3 class="fw-bold text-dark mb-1">Verify Your Email</h3>
                <p class="text-secondary small mb-2">
                    We sent a 6-digit verification code to:
                </p>
                <div class="fw-bold text-primary mb-3 text-break" style="font-size: 0.98rem;">
                    @Model.Email
                </div>

                <!-- Feedback Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 text-start small rounded-3 border-0 shadow-sm" role="alert">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 py-2 px-3 mb-3 text-start small rounded-3 border-0 shadow-sm" role="alert">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <div>@TempData["WarningMessage"]</div>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 text-start small rounded-3 border-0 shadow-sm" role="alert">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3 text-start small rounded-3 border-0 shadow-sm">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <!-- OTP Verification Form -->
                <form asp-action="VerifyOtp" method="post" id="otpForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Otp" id="completeOtpInput" />

                    <!-- 6 Digit Input Boxes -->
                    <div class="otp-container">
                        <input type="text" class="otp-box" maxlength="1" pattern="\d" inputmode="numeric" autocomplete="one-time-code" autofocus />
                        <input type="text" class="otp-box" maxlength="1" pattern="\d" inputmode="numeric" />
                        <input type="text" class="otp-box" maxlength="1" pattern="\d" inputmode="numeric" />
                        <input type="text" class="otp-box" maxlength="1" pattern="\d" inputmode="numeric" />
                        <input type="text" class="otp-box" maxlength="1" pattern="\d" inputmode="numeric" />
                        <input type="text" class="otp-box" maxlength="1" pattern="\d" inputmode="numeric" />
                    </div>

                    <!-- Expiration Timer -->
                    <div class="mb-4">
                        <span class="timer-badge" id="timerBadge">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
                            </svg>
                            <span>Code expires in: <strong id="timerDisplay">15:00</strong></span>
                        </span>
                    </div>

                    <button type="submit" class="btn-submit mb-3" id="verifyBtn">
                        <span>Verify Code & Continue</span>
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                </form>

                <!-- Resend OTP Form -->
                <div class="d-flex align-items-center justify-content-center gap-2 pt-2 border-top">
                    <span class="text-secondary small">Didn't receive the code?</span>
                    <form asp-action="ResendOtp" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-link text-primary p-0 small fw-bold text-decoration-none" id="resendBtn">
                            Resend OTP
                        </button>
                    </form>
                </div>

                <div class="mt-3">
                    <a asp-action="Login" class="text-secondary small text-decoration-none">
                        &larr; Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const boxes = Array.from(document.querySelectorAll(".otp-box"));
            const completeInput = document.getElementById("completeOtpInput");
            const form = document.getElementById("otpForm");

            // Focus on the first box
            if (boxes.length > 0) {
                boxes[0].focus();
            }

            function updateCompleteOtp() {
                const otpVal = boxes.map(b => b.value).join("");
                completeInput.value = otpVal;
                return otpVal;
            }

            boxes.forEach((box, index) => {
                box.addEventListener("input", function (e) {
                    const val = e.target.value;
                    if (!/^\d*$/.test(val)) {
                        e.target.value = "";
                        return;
                    }

                    if (val.length > 0) {
                        box.classList.add("filled");
                        if (index < boxes.length - 1) {
                            boxes[index + 1].focus();
                        }
                    } else {
                        box.classList.remove("filled");
                    }

                    const otp = updateCompleteOtp();
                    if (otp.length === 6) {
                        // Auto submit when all 6 digits entered
                        form.submit();
                    }
                });

                box.addEventListener("keydown", function (e) {
                    if (e.key === "Backspace") {
                        if (box.value === "" && index > 0) {
                            boxes[index - 1].focus();
                            boxes[index - 1].value = "";
                            boxes[index - 1].classList.remove("filled");
                        } else {
                            box.value = "";
                            box.classList.remove("filled");
                        }
                        updateCompleteOtp();
                    } else if (e.key === "ArrowLeft" && index > 0) {
                        boxes[index - 1].focus();
                    } else if (e.key === "ArrowRight" && index < boxes.length - 1) {
                        boxes[index + 1].focus();
                    }
                });

                box.addEventListener("paste", function (e) {
                    e.preventDefault();
                    const pasteData = (e.clipboardData || window.clipboardData).getData("text").trim();
                    const digits = pasteData.replace(/\D/g, "").slice(0, 6);

                    if (digits.length > 0) {
                        digits.split("").forEach((digit, i) => {
                            if (i < boxes.length) {
                                boxes[i].value = digit;
                                boxes[i].classList.add("filled");
                            }
                        });

                        const nextIndex = Math.min(digits.length, boxes.length - 1);
                        boxes[nextIndex].focus();

                        const otp = updateCompleteOtp();
                        if (otp.length === 6) {
                            form.submit();
                        }
                    }
                });
            });

            // 15-Minute Countdown Timer
            let durationSeconds = 15 * 60;
            const timerDisplay = document.getElementById("timerDisplay");
            const timerBadge = document.getElementById("timerBadge");

            const interval = setInterval(function () {
                durationSeconds--;
                if (durationSeconds <= 0) {
                    clearInterval(interval);
                    timerDisplay.textContent = "Expired";
                    timerBadge.classList.add("expiring");
                } else {
                    const minutes = Math.floor(durationSeconds / 60);
                    const seconds = durationSeconds % 60;
                    timerDisplay.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                    if (durationSeconds < 120) {
                        timerBadge.classList.add("expiring");
                    }
                }
            }, 1000);
        });
    </script>
</body>
</html>
