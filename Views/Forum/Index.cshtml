@model Onudhabon_ISD.Models.ForumIndexViewModel
@using System.Security.Claims
@inject Onudhabon_ISD.Services.ICloudinaryService CloudinaryService

@{
    ViewData["Title"] = "Community Forum";
    var userReactions = ViewBag.UserReactions as Dictionary<int, bool> ?? new Dictionary<int, bool>();
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="forum-page">
    <!-- Hero Section with Background Image -->
    <section class="forum-hero">
        <div class="forum-hero-overlay"></div>
        <div class="forum-hero-content">
            <div class="forum-hero-badge">
                <i class="bi bi-chat-dots-fill"></i>
                <span>Community Exchange</span>
            </div>
            <h1>Collaborate, Ask & Share</h1>
            <p>
                Connect with educators, volunteers, and local guardians across Bangladesh. 
                Exchange ideas, discuss curriculum questions, and empower students together.
            </p>
            <div>
                @if (isAuthenticated)
                {
                    <button type="button" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;" data-bs-toggle="modal" data-bs-target="#createPostModal">
                        <i class="bi bi-plus-lg"></i>
                        <span>Start New Discussion</span>
                    </button>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Forum" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login to Participate</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Main Content Container -->
    <div class="container py-5" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h4 class="fw-bold text-dark mb-1">Recent Discussions</h4>
                <p class="text-muted small mb-0">Community posts from verified educators and guardians</p>
            </div>
            @if (isAuthenticated)
            {
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3.5 py-1.5 d-inline-flex align-items-center gap-1.5" data-bs-toggle="modal" data-bs-target="#createPostModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>New Post</span>
                </button>
            }
        </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Posts Feed -->
    <div class="d-flex flex-column gap-3">
        @if (!Model.Posts.Any())
        {
            <div class="text-center py-5 bg-light rounded-4 border">
                <h5 class="text-muted">No forum posts yet.</h5>
                <p class="text-muted small">Be the first to start a conversation!</p>
            </div>
        }
        else
        {
            foreach (var post in Model.Posts)
            {
                bool hasReaction = userReactions.TryGetValue(post.Id, out bool isLike);
                bool isLiked = hasReaction && isLike;
                bool isDisliked = hasReaction && !isLike;
                Model.AuthorPreviews.TryGetValue(post.Author ?? string.Empty, out var authorPreview);

                <div id="post-@post.Id" class="card border border-light-subtle rounded-3 shadow-sm p-3 p-sm-4 bg-white hover-shadow transition">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2 flex-wrap">
                        <h4 class="fw-bold text-dark mb-0">@post.Title</h4>
                        @if (post.Status == "Pending" || post.Status == "pending" || string.IsNullOrEmpty(post.Status))
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1 text-nowrap d-inline-flex align-items-center gap-1">
                                <i class="bi bi-clock-history"></i>
                                <span>Pending Admin Approval</span>
                            </span>
                        }
                        else if (post.Status == "Declined" || post.Status == "declined")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 text-nowrap d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>Declined</span>
                            </span>
                        }
                    </div>
                    
                    <div class="d-flex align-items-center flex-wrap gap-2 text-muted small mb-3">
                        <span>By</span>
                        @if (authorPreview != null)
                        {
                            var authorPictureUrl = string.IsNullOrWhiteSpace(authorPreview.Picture) ? string.Empty : CloudinaryService.GetAvatarUrl(authorPreview.Picture, 48);
                            var previewPictureUrl = string.IsNullOrWhiteSpace(authorPreview.Picture) ? string.Empty : CloudinaryService.GetAvatarUrl(authorPreview.Picture, 200);
                            <button type="button"
                                    class="btn p-0 border-0 bg-transparent text-dark fw-semibold d-inline-flex align-items-center gap-1.5"
                                    data-bs-toggle="modal"
                                    data-bs-target="#authorPreviewModal"
                                    data-author-name="@authorPreview.FullName"
                                    data-author-picture="@previewPictureUrl"
                                    data-author-role="@authorPreview.Role"
                                    data-author-location="@authorPreview.Location"
                                    data-author-education="@authorPreview.Education"
                                    data-author-member-since="@(authorPreview.MemberSince == default ? "—" : authorPreview.MemberSince.ToString("MMMM yyyy"))"
                                    data-author-forum-posts="@authorPreview.ForumPostCount"
                                    data-author-lectures="@authorPreview.LectureCount"
                                    aria-label="View @authorPreview.FullName's public profile">
                                @if (!string.IsNullOrEmpty(authorPictureUrl))
                                {
                                    <img src="@authorPictureUrl" alt="" class="rounded-circle border flex-shrink-0" style="width: 26px; height: 26px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="rounded-circle bg-primary-subtle text-primary fw-bold d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; font-size: 0.75rem; line-height: 1;">@(string.IsNullOrEmpty(authorPreview.FullName) ? "U" : authorPreview.FullName.Substring(0, 1).ToUpper())</span>
                                }
                                <span>@authorPreview.FullName</span>
                            </button>
                        }
                        else
                        {
                            <span class="fw-semibold text-dark">@(post.Author ?? "Anonymous")</span>
                        }
                        @if (!string.IsNullOrEmpty(post.AuthorRole))
                        {
                            <span class="text-muted">(@post.AuthorRole)</span>
                        }
                        <span>•</span>
                        <span>@post.CreatedAt.ToString("M/d/yyyy, h:mm:ss tt")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(post.Tags))
                    {
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in post.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-primary text-white font-monospace px-2 py-1 rounded-2" style="font-weight: 500; font-size: 0.85rem;">@tag</span>
                            }
                        </div>
                    }

                    <p class="text-dark fs-6 mb-2.5 mb-sm-3" style="line-height: 1.6; white-space: pre-line;">@post.Content</p>

                    <div class="d-flex align-items-center border-top pt-2 flex-nowrap gap-1.5 gap-sm-2 forum-actions-row">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2 px-sm-3 py-1 fw-semibold toggle-details-btn d-inline-flex align-items-center gap-1 text-nowrap" data-post-id="@post.Id">
                            <i class="bi bi-chat-dots"></i>
                            <span><span class="d-none d-sm-inline">View </span>Details (<span id="reply-count-@post.Id">@post.Replies</span><span class="d-none d-md-inline"> replies</span>)</span>
                        </button>

                        <button type="button" 
                                class="btn @(isLiked ? "btn-success text-white" : "btn-outline-success") btn-sm rounded-3 px-2 px-sm-3 py-1 fw-medium like-btn d-inline-flex align-items-center gap-1 text-nowrap" 
                                id="like-btn-@post.Id"
                                data-post-id="@post.Id"
                                data-is-active="@(isLiked ? "true" : "false")">
                            <i class="bi bi-hand-thumbs-up"></i>
                            <span>Like (<span id="like-count-@post.Id">@post.Likes</span>)</span>
                        </button>

                        <button type="button" 
                                class="btn @(isDisliked ? "btn-danger text-white" : "btn-outline-danger") btn-sm rounded-3 px-2 px-sm-3 py-1 fw-medium dislike-btn d-inline-flex align-items-center gap-1 text-nowrap" 
                                id="dislike-btn-@post.Id"
                                data-post-id="@post.Id"
                                data-is-active="@(isDisliked ? "true" : "false")">
                            <i class="bi bi-hand-thumbs-down"></i>
                            <span>Dislike (<span id="dislike-count-@post.Id">@post.Dislikes</span>)</span>
                        </button>
                    </div>

                    <!-- Details / Replies Accordion Section -->
                    <div id="details-section-@post.Id" class="mt-3 pt-3 border-top d-none">
                        <h6 class="fw-bold mb-3 text-secondary">Replies & Comments</h6>
                        
                        <div id="comments-list-@post.Id" class="d-flex flex-column gap-2 mb-3">
                            <div class="text-muted small">Loading comments...</div>
                        </div>

                        @if (isAuthenticated)
                        {
                            <div class="input-group">
                                <input type="text" id="comment-input-@post.Id" class="form-control rounded-start-3" placeholder="Write a reply..." />
                                <button type="button" class="btn btn-primary rounded-end-3 submit-comment-btn" data-post-id="@post.Id">Reply</button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border small text-muted mb-0">
                                Please <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Forum" class="fw-semibold">log in</a> to leave a reply.
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
</div>

<div class="modal fade" id="authorPreviewModal" tabindex="-1" aria-labelledby="authorPreviewName" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow overflow-hidden">
            <div class="position-relative" style="height: 100px; background: linear-gradient(120deg, #1e40af, #2563eb);">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pt-0">
                <div class="d-flex justify-content-between align-items-end" style="margin-top: -48px;">
                    <img id="authorPreviewPicture" src="" alt="" class="rounded-circle border border-3 border-white shadow" style="width: 88px; height: 88px; object-fit: cover; display: none;" />
                    <div id="authorPreviewFallback" class="rounded-circle border border-3 border-white shadow bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center d-none" style="width: 88px; height: 88px; font-size: 2rem;">U</div>
                    <span id="authorPreviewRole" class="badge bg-success-subtle text-success border rounded-pill px-3 py-2 mb-1"></span>
                </div>
                <h5 id="authorPreviewName" class="fw-bold text-dark mt-3 mb-1"></h5>
                <div class="text-muted small mb-3"><i class="bi bi-geo-alt text-primary"></i><span id="authorPreviewLocation" class="ms-1"></span></div>
                <div class="row g-2 border-top border-bottom py-3 small">
                    <div class="col-6">
                        <div class="text-muted text-uppercase">Qualification</div>
                        <div id="authorPreviewEducation" class="fw-semibold text-dark"></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted text-uppercase">Member Since</div>
                        <div id="authorPreviewMemberSince" class="fw-semibold text-dark"></div>
                    </div>
                </div>
                <div class="row g-2 pt-3 text-center">
                    <div class="col-6">
                        <div class="border rounded-3 p-2">
                            <div id="authorPreviewForumPosts" class="fw-bold text-primary fs-5"></div>
                            <div class="text-muted small text-uppercase">Forum Posts</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded-3 p-2">
                            <div id="authorPreviewLectures" class="fw-bold text-success fs-5"></div>
                            <div class="text-muted small text-uppercase">Lectures Shared</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-3 justify-content-between">
                <span class="text-muted small">Onudhabon Community Exchange</span>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for New Post -->
@if (isAuthenticated)
{
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-labelledby="createPostModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="createPostModalLabel">Start a New Discussion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreatePost" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                            </svg>
                            <span>Discussions are submitted for administrator moderation before being visible to everyone.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title</label>
                            <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Physics Lecture Guidance" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Content</label>
                            <textarea name="content" class="form-control rounded-3" rows="4" placeholder="Share details about what you want to discuss..." required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tags (space separated)</label>
                            <input type="text" name="tags" class="form-control rounded-3" placeholder="e.g. #discussion #lectures" />
                        </div>
                    </div>
                    <div class="modal-footer border-top px-4 py-3">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Submit for Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('authorPreviewModal').addEventListener('show.bs.modal', function (event) {
            var trigger = event.relatedTarget;
            if (!trigger) return;

            var data = trigger.dataset;
            var picture = document.getElementById('authorPreviewPicture');
            var fallback = document.getElementById('authorPreviewFallback');
            document.getElementById('authorPreviewName').textContent = data.authorName || 'Community Member';
            document.getElementById('authorPreviewRole').textContent = data.authorRole || 'Community Member';
            document.getElementById('authorPreviewLocation').textContent = data.authorLocation || '—';
            document.getElementById('authorPreviewEducation').textContent = data.authorEducation || '—';
            document.getElementById('authorPreviewMemberSince').textContent = data.authorMemberSince || '—';
            document.getElementById('authorPreviewForumPosts').textContent = data.authorForumPosts || '0';
            document.getElementById('authorPreviewLectures').textContent = data.authorLectures || '0';
            fallback.textContent = (data.authorName || 'U').charAt(0).toUpperCase();
            picture.alt = data.authorName || '';
            picture.src = data.authorPicture || '';
            picture.style.display = data.authorPicture ? 'block' : 'none';
            fallback.classList.toggle('d-none', Boolean(data.authorPicture));
        });

        $(document).ready(function () {
            var isAuthenticated = @(isAuthenticated ? "true" : "false");
            var loginUrl = '@Url.Action("Login", "Account", new { returnUrl = "/Forum" })';

            // Auto open & scroll to post if hash URL is provided (e.g. #post-5)
            if (window.location.hash) {
                var targetPost = $(window.location.hash);
                if (targetPost.length) {
                    $('html, body').animate({
                        scrollTop: targetPost.offset().top - 80
                    }, 500);

                    targetPost.addClass('border-primary shadow');
                    var postIdFromHash = window.location.hash.replace('#post-', '');
                    var detailsDivFromHash = $('#details-section-' + postIdFromHash);
                    if (detailsDivFromHash.length) {
                        detailsDivFromHash.removeClass('d-none');
                        loadComments(postIdFromHash);
                    }
                }
            }

            function updateReactionUI(postId, likes, dislikes, userReaction) {
                $('#like-count-' + postId).text(likes);
                $('#dislike-count-' + postId).text(dislikes);

                var likeBtn = $('#like-btn-' + postId);
                var dislikeBtn = $('#dislike-btn-' + postId);

                if (userReaction === 'like') {
                    likeBtn.removeClass('btn-outline-success').addClass('btn-success text-white').attr('data-is-active', 'true');
                    dislikeBtn.removeClass('btn-danger text-white').addClass('btn-outline-danger').attr('data-is-active', 'false');
                } else if (userReaction === 'dislike') {
                    dislikeBtn.removeClass('btn-outline-danger').addClass('btn-danger text-white').attr('data-is-active', 'true');
                    likeBtn.removeClass('btn-success text-white').addClass('btn-outline-success').attr('data-is-active', 'false');
                } else {
                    // 'none' or undone
                    likeBtn.removeClass('btn-success text-white').addClass('btn-outline-success').attr('data-is-active', 'false');
                    dislikeBtn.removeClass('btn-danger text-white').addClass('btn-outline-danger').attr('data-is-active', 'false');
                }
            }

            // Toggle Details/Comments section
            $('.toggle-details-btn').click(function () {
                var postId = $(this).data('post-id');
                var detailsDiv = $('#details-section-' + postId);
                
                if (detailsDiv.hasClass('d-none')) {
                    detailsDiv.removeClass('d-none');
                    loadComments(postId);
                } else {
                    detailsDiv.addClass('d-none');
                }
            });

            // Load Comments
            function loadComments(postId) {
                var commentsList = $('#comments-list-' + postId);
                $.get('/Forum/GetComments', { postId: postId }, function (data) {
                    commentsList.empty();
                    if (data.length === 0) {
                        commentsList.append('<div class="text-muted small italic">No replies yet. Be the first to reply!</div>');
                    } else {
                        $.each(data, function (i, c) {
                            var authorRoleHtml = c.authorRole ? ' <span class="text-muted">(' + c.authorRole + ')</span>' : '';
                            var item = '<div class="p-2.5 bg-light rounded-3 border small">' +
                                '<div class="fw-semibold text-dark mb-1">' + c.author + authorRoleHtml + ' <span class="text-muted fw-normal float-end">' + c.createdAt + '</span></div>' +
                                '<div class="text-dark">' + c.content + '</div>' +
                                '</div>';
                            commentsList.append(item);
                        });
                    }
                });
            }

            // Submit Reply Comment
            $('.submit-comment-btn').click(function () {
                var postId = $(this).data('post-id');
                var input = $('#comment-input-' + postId);
                var content = input.val().trim();
                if (!content) return;

                $.post('/Forum/AddComment', { postId: postId, content: content }, function (res) {
                    if (res.success) {
                        input.val('');
                        $('#reply-count-' + postId).text(res.replies);
                        loadComments(postId);
                    } else {
                        alert(res.message || 'Error adding reply.');
                    }
                });
            });

            // Like Action
            $(document).on('click', '.like-btn', function () {
                if (!isAuthenticated) {
                    window.location.href = loginUrl;
                    return;
                }

                var postId = $(this).data('post-id');
                var btn = $(this);
                btn.prop('disabled', true);

                $.post('/Forum/Like', { id: postId }, function (res) {
                    btn.prop('disabled', false);
                    if (res.requireLogin) {
                        window.location.href = res.redirectUrl || loginUrl;
                        return;
                    }
                    if (res.success) {
                        updateReactionUI(postId, res.likes, res.dislikes, res.userReaction);
                    }
                }).fail(function () {
                    btn.prop('disabled', false);
                });
            });

            // Dislike Action
            $(document).on('click', '.dislike-btn', function () {
                if (!isAuthenticated) {
                    window.location.href = loginUrl;
                    return;
                }

                var postId = $(this).data('post-id');
                var btn = $(this);
                btn.prop('disabled', true);

                $.post('/Forum/Dislike', { id: postId }, function (res) {
                    btn.prop('disabled', false);
                    if (res.requireLogin) {
                        window.location.href = res.redirectUrl || loginUrl;
                        return;
                    }
                    if (res.success) {
                        updateReactionUI(postId, res.likes, res.dislikes, res.userReaction);
                    }
                }).fail(function () {
                    btn.prop('disabled', false);
                });
            });
        });
    </script>
}
