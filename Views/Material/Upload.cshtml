@model Onudhabon_ISD.Models.MaterialUploadViewModel

@{
    ViewData["Title"] = "Upload Study Material - Onudhabon";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                    ← Back to Materials
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex p-3 mb-2">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h3 class="fw-bold text-dark">Upload Study Material</h3>
                    <p class="text-muted">Files are stored in <code>onudhabon/materials</code> with automatic size calculation.</p>
                </div>

                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Material / Document Title *</label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="e.g. Physics Formula Sheet & Practice Set - Class 10" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Class & Subject & Topic -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ClassLevel" class="form-label fw-semibold">Class Level *</label>
                            <select asp-for="ClassLevel" class="form-select rounded-3">
                                <option value="">Select Class</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">Class @i</option>
                                }
                            </select>
                            <span asp-validation-for="ClassLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject *</label>
                            <input asp-for="Subject" class="form-control rounded-3" placeholder="e.g. Physics, Bangla..." />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Topic" class="form-label fw-semibold">Topic *</label>
                            <input asp-for="Topic" class="form-control rounded-3" placeholder="e.g. Optics and Waves" />
                            <span asp-validation-for="Topic" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Medium & Instructor -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Version" class="form-label fw-semibold">Medium / Version</label>
                            <select asp-for="Version" class="form-select rounded-3">
                                <option value="Bangla">Bangla Medium</option>
                                <option value="English">English Medium</option>
                                <option value="English Version">English Version</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Instructor" class="form-label fw-semibold">Author / Educator</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0 rounded-start-3">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                                <input asp-for="Instructor" class="form-control rounded-end-3 bg-light" readonly tabindex="-1" style="cursor: not-allowed;" />
                            </div>
                            <span class="text-muted small">Fetched automatically from your profile name.</span>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description / Notes</label>
                        <textarea asp-for="Description" rows="3" class="form-control rounded-3" placeholder="Summary of what topics or practice questions are included..."></textarea>
                    </div>

                    <!-- Document File Upload (Cloudinary) -->
                    <div class="mb-4">
                        <label asp-for="MaterialFile" class="form-label fw-semibold">Select Document File (.pdf, .docx, .doc, .pptx, .ppt) *</label>
                        <input asp-for="MaterialFile" type="file" id="materialFileInput" accept=".pdf,.doc,.docx,.ppt,.pptx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation" class="form-control form-control-lg rounded-3" />
                        <span class="text-muted small d-block mt-1">Allowed formats: PDF, DOCX, DOC, PPTX, PPT. Uploaded to <code>onudhabon/materials</code>.</span>
                        <div id="materialFileError" class="text-danger small mt-1 fw-medium" style="display: none;"></div>
                        <span asp-validation-for="MaterialFile" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">
                        Upload & Submit Material (Status: Pending)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const materialInput = document.getElementById('materialFileInput');
            const errorDiv = document.getElementById('materialFileError');
            const allowedExtensions = ['.pdf', '.doc', '.docx', '.ppt', '.pptx'];
            const dangerousExtensions = ['.exe', '.bat', '.cmd', '.sh', '.vbs', '.js', '.msi', '.scr', '.jar', '.ps1', '.apk', '.com', '.pif', '.dll', '.bin', '.iso', '.wsf'];

            if (materialInput) {
                materialInput.addEventListener('change', function () {
                    validateMaterialFile();
                });

                const form = materialInput.closest('form');
                if (form) {
                    form.addEventListener('submit', function (e) {
                        if (!validateMaterialFile()) {
                            e.preventDefault();
                            materialInput.focus();
                        }
                    });
                }
            }

            function validateMaterialFile() {
                if (!materialInput.files || materialInput.files.length === 0) {
                    return true;
                }

                const file = materialInput.files[0];
                const fileName = file.name.toLowerCase();
                const lastDot = fileName.lastIndexOf('.');

                if (lastDot === -1) {
                    showError('Please upload a valid document file with an extension (.pdf, .docx, .doc, .pptx, .ppt).');
                    materialInput.value = '';
                    return false;
                }

                const ext = fileName.substring(lastDot);

                if (dangerousExtensions.includes(ext)) {
                    showError(`Security Alert: Executable/script files (${ext}) are strictly prohibited. Please select an allowed document file (.pdf, .docx, .doc, .pptx, .ppt).`);
                    materialInput.value = '';
                    return false;
                }

                if (!allowedExtensions.includes(ext)) {
                    showError(`Invalid file format '${ext}'. Only document files (.pdf, .docx, .doc, .pptx, .ppt) are allowed.`);
                    materialInput.value = '';
                    return false;
                }

                clearError();
                return true;
            }

            function showError(msg) {
                if (errorDiv) {
                    errorDiv.textContent = msg;
                    errorDiv.style.display = 'block';
                }
            }

            function clearError() {
                if (errorDiv) {
                    errorDiv.textContent = '';
                    errorDiv.style.display = 'none';
                }
            }
        });
    </script>
}
